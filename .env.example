# ============================================================
# VARIABLES DE ENTORNO - SISTEMA GMP v2
# ============================================================

# --- Backend (Carpeta backend/.env o Render Env Vars) ---
# URL de tu proyecto en Supabase (Settings > API > Project URL)
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
# Service Role Key (Settings > API > service_role) - NO la anon key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# JWT Secret (Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=tu-jwt-secret-aqui

# --- Frontend (Carpeta frontend/.env o Vercel Env Vars) ---
# URL del backend desplegado en Render
VITE_API_URL=http://localhost:8000
# URL de Supabase (la misma de arriba)
VITE_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
# Anon Key de Supabase (Settings > API > anon public) - esta SI es la publica
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
