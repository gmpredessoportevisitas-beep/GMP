{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET,OPTIONS,PATCH,DELETE,POST,PUT",
        "Access-Control-Allow-Headers": "Authorization, X-Requested-With, Content-Type, Accept"
      }
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/assets/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "frontend/favicon.svg"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "frontend/manifest.webmanifest"
    },
    {
      "src": "/sw.js",
      "dest": "frontend/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/workbox-(.*).js",
      "dest": "frontend/workbox-$1.js"
    },
    {
      "src": "/logo.png",
      "dest": "frontend/logo.png"
    },
    {
      "src": "/logo-white.png",
      "dest": "frontend/logo-white.png"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "frontend/index.html"
    }
  ]
}